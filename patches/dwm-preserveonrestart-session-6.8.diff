+/* floats are stored bit-exact in 32-bit CARDINAL properties */
+long
+ftol(float f)
+{
+	union { float f; unsigned int u; } v = { .f = f };
+
+	return v.u;
+}
+
+float
+ltof(long l)
+{
+	union { float f; unsigned int u; } v = { .u = l };
+
+	return v.f;
+}
